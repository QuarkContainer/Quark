{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuarkBenchmarkReport",
  "type": "object",
  "required": ["schema_version", "metadata", "suites"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "metadata": {
      "type": "object",
      "required": ["timestamp", "runtime", "profile"],
      "properties": {
        "timestamp": { "type": "string" },
        "git_commit": { "type": "string" },
        "runtime": { "type": "string" },
        "profile": { "type": "string" },
        "lima": { "type": "object" },
        "quark": { "type": "object" },
        "params": { "type": "object" }
      }
    },
    "suites": { "type": "object" },
    "host_snapshots": { "type": "array" }
  }
}
